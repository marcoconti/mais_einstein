        <mxCell id="BDG2bmEEKNZtttDjlLxS-235" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;labelBorderColor=default;" value="A autenticação no portal CDS será feita por um &lt;b&gt;Token&lt;/b&gt;, que é fornecido após cadastro no portal.&lt;div&gt;&lt;br&gt;&lt;div&gt;O cadastro deverá ser feito usando um e-mail de serviços&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Sugestão de armazenamento:&lt;br&gt;&lt;b&gt;Databricks Secret&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
