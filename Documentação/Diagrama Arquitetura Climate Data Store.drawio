        <mxCell id="BDG2bmEEKNZtttDjlLxS-248" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=bottom;rounded=0;fontSize=16;" value="&lt;div&gt;&lt;font&gt;Todas as bibliotecas citadas&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;no diagrama&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;e suas dependências passaram por testes de vulnerabilidade usando a ferramenta pip-audit e o resultado:&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;b style=&quot;&quot;&gt;&lt;span data-contrast=&quot;none&quot; lang=&quot;PT-BR&quot; class=&quot;TextRun SCXW241241113 BCX8&quot; style=&quot;-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; color: rgb(51, 51, 51); background-color: rgb(255, 255, 255); line-height: 20px; font-family: Arial, Arial_EmbeddedFont, Arial_MSFontService, sans-serif; font-variant-ligatures: none !important;&quot;&gt;&lt;span class=&quot;NormalTextRun SCXW241241113 BCX8&quot; style=&quot;-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text;&quot;&gt;Índice de Conformidade de Segurança&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;EOP Selected SCXW241241113 BCX8&quot; data-ccp-props=&quot;{&amp;quot;335557856&amp;quot;:4278190080,&amp;quot;335559738&amp;quot;:120,&amp;quot;335559739&amp;quot;:120,&amp;quot;335572071&amp;quot;:0,&amp;quot;335572072&amp;quot;:0,&amp;quot;335572073&amp;quot;:0,&amp;quot;335572075&amp;quot;:0,&amp;quot;335572076&amp;quot;:0,&amp;quot;335572077&amp;quot;:0,&amp;quot;335572079&amp;quot;:0,&amp;quot;335572080&amp;quot;:0,&amp;quot;335572081&amp